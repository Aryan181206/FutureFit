<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/exploreFrag"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".Fragments.ExploreFrag">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <include layout="@layout/toolbar"/>

        <!-- Title Section -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingHorizontal="16dp"
            android:paddingTop="8dp"
            android:paddingBottom="12dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Explore Stories"
                android:textColor="@color/black"
                android:textSize="20sp"
                android:textStyle="bold"
                android:fontFamily="@font/monda" />
        </LinearLayout>

        <!-- Scrollable Content -->
        <ScrollView
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:fillViewport="true">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingBottom="24dp">

                <!-- RecyclerView for Success Stories -->
                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/successStoriesRV"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:layout_marginHorizontal="16dp"
                    android:clipToPadding="false"
                    android:paddingBottom="8dp" />

                <!-- Resources Section -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:orientation="vertical"
                    android:paddingHorizontal="16dp">

                    <!-- Search Jobs Card -->
                    <com.google.android.material.card.MaterialCardView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="16dp"
                        app:cardCornerRadius="12dp"
                        app:cardElevation="2dp"
                        app:strokeColor="#EEEEEE"
                        app:strokeWidth="1dp">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="vertical"
                            android:padding="16dp">

                            <TextView
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:text="Search Jobs"
                                android:textColor="@color/black"
                                android:textSize="18sp"
                                android:textStyle="bold"
                                android:fontFamily="@font/monda" />

                            <TextView
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="4dp"
                                android:text="Explore your favorite jobs on naukari.com"
                                android:textColor="#616161"
                                android:textSize="14sp"
                                android:fontFamily="@font/monda" />

                            <com.google.android.material.card.MaterialCardView
                                android:id="@+id/tojob"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="12dp"
                                android:backgroundTint="#FDFDFD"
                                app:cardCornerRadius="8dp"
                                app:strokeColor="#E0E0E0"
                                app:strokeWidth="1dp">

                                <ImageView
                                    android:layout_width="180dp"
                                    android:layout_height="55dp"
                                    android:layout_gravity="center"
                                    android:adjustViewBounds="true"
                                    android:padding="8dp"
                                    android:scaleType="fitCenter"
                                    android:src="@drawable/job" />
                            </com.google.android.material.card.MaterialCardView>
                        </LinearLayout>
                    </com.google.android.material.card.MaterialCardView>

                    <!-- Courses Card -->
                    <com.google.android.material.card.MaterialCardView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="16dp"
                        app:cardCornerRadius="12dp"
                        app:cardElevation="2dp"
                        app:strokeColor="#EEEEEE"
                        app:strokeWidth="1dp">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="vertical"
                            android:padding="16dp">

                            <TextView
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:text="Courses"
                                android:textColor="@color/black"
                                android:textSize="18sp"
                                android:textStyle="bold"
                                android:fontFamily="@font/monda" />

                            <TextView
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="4dp"
                                android:text="Explore courses to learn new skills with Alison.com"
                                android:textColor="#616161"
                                android:textSize="14sp"
                                android:fontFamily="@font/monda" />

                            <com.google.android.material.card.MaterialCardView
                                android:id="@+id/tocourses"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="12dp"
                                android:backgroundTint="#FDFDFD"
                                app:cardCornerRadius="8dp"
                                app:strokeColor="#E0E0E0"
                                app:strokeWidth="1dp">

                                <ImageView
                                    android:layout_width="180dp"
                                    android:layout_height="55dp"
                                    android:layout_gravity="center"
                                    android:adjustViewBounds="true"
                                    android:padding="8dp"
                                    android:scaleType="fitCenter"
                                    android:src="@drawable/courses" />
                            </com.google.android.material.card.MaterialCardView>
                        </LinearLayout>
                    </com.google.android.material.card.MaterialCardView>

                    <!-- Career Blogs Card -->
                    <com.google.android.material.card.MaterialCardView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="16dp"
                        app:cardCornerRadius="12dp"
                        app:cardElevation="2dp"
                        app:strokeColor="#EEEEEE"
                        app:strokeWidth="1dp">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="vertical"
                            android:padding="16dp">

                            <TextView
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:text="Career Blogs"
                                android:textColor="@color/black"
                                android:textSize="18sp"
                                android:textStyle="bold"
                                android:fontFamily="@font/monda" />

                            <TextView
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="4dp"
                                android:text="Learn from experiences of great personalities at Medium.com"
                                android:textColor="#616161"
                                android:textSize="14sp"
                                android:fontFamily="@font/monda" />

                            <com.google.android.material.card.MaterialCardView
                                android:id="@+id/toblog"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="12dp"
                                android:backgroundTint="#FDFDFD"
                                app:cardCornerRadius="8dp"
                                app:strokeColor="#E0E0E0"
                                app:strokeWidth="1dp">

                                <ImageView
                                    android:layout_width="180dp"
                                    android:layout_height="50dp"
                                    android:layout_gravity="center"
                                    android:adjustViewBounds="true"
                                    android:padding="8dp"
                                    android:scaleType="fitCenter"
                                    android:src="@drawable/blog" />
                            </com.google.android.material.card.MaterialCardView>
                        </LinearLayout>
                    </com.google.android.material.card.MaterialCardView>
                </LinearLayout>
            </LinearLayout>
        </ScrollView>
    </LinearLayout>
</FrameLayout>