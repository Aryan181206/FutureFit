<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".AssessmentInstructions.PersonalityTestInstruction">


    <androidx.cardview.widget.CardView
        android:layout_width="match_parent"
        android:layout_height="65dp"
        >
        <ImageView
            android:layout_width="200dp"
            android:layout_height="60dp"
            android:layout_marginStart="10dp"
            android:src="@drawable/finallogo2"/>
    </androidx.cardview.widget.CardView>

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Personality Trait Test"
        android:textSize="26dp"
        android:textStyle="bold"
        android:textColor="@color/black"
        android:fontFamily="@font/monda"
        android:layout_marginTop="10dp"
        android:textAlignment="center"
        android:layout_gravity="center_horizontal"/>

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Instructions"
        android:textColor="@color/black"
        android:textStyle="bold"
        android:textSize="20dp"
        android:layout_marginTop="8dp"
        android:layout_marginStart="15dp"
        android:fontFamily="@font/monda"/>

    <ScrollView
        android:layout_width="wrap_content"

        android:layout_height="wrap_content">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="vertical">

    <TextView
        android:id="@+id/textView"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Welcome to the Personality Profiler!&#xA;&#xA;This short test will help you understand your work preferences and potential career paths based on your natural tendencies.&#xA;&#xA;It explores four key aspects of your personality:&#xA;&#xA;How you direct your energy: Do you gain energy from being around people (Extroverted) or from spending time alone (Introverted)?&#xA;&#xA;How you take in information: Do you focus on facts and details (Sensing) or possibilities and patterns (Intuition)?&#xA;&#xA;How you make decisions: Do you prioritize logic and objectivity (Thinking) or values and people&apos;s feelings (Feeling)?&#xA;&#xA;How you prefer to live your outer life: Do you prefer to be organized and planned (Judging) or flexible and spontaneous (Perceiving)?&#xA;&#xA;For each question, please choose the answer that best reflects your typical preferences and behaviors.&#xA;&#xA;There are no right or wrong answers – be honest with yourself!&#xA;&#xA;This test is designed to provide insights and suggestions, not definitive labels.&#xA;&#xA;Your results will highlight potential work environments and career types that might be a good fit for your personality style.&#xA;&#xA;Ready to discover more about yourself? Click &apos;Start&apos; to begin!"
        android:textColor="@color/black"
        android:layout_marginTop="10dp"
        android:layout_marginHorizontal="12dp"
        android:textSize="16sp"/>

            <androidx.cardview.widget.CardView
                android:id="@+id/startPersonalityTest"
                android:layout_width="match_parent"
                android:layout_height="50dp"
                android:layout_marginHorizontal="10dp"
                android:backgroundTint="@color/Sky"
                android:elevation="5dp"
                android:layout_marginBottom="15dp"
                android:layout_marginTop="25dp"
                app:cardMaxElevation="100dp"
                app:cardElevation="10dp"
                app:cardCornerRadius="10dp"
                >
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:text="Start"
                    android:fontFamily="@font/baloo_thambi"
                    android:textSize="25dp"
                    android:layout_gravity="center"
                    android:gravity="center"
                    android:textColor="@color/Royalwhite"/>
            </androidx.cardview.widget.CardView>

        </LinearLayout>

    </ScrollView>













</LinearLayout>