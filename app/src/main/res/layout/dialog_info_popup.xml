<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_margin="10dp"
    android:layout_height="500dp"
    app:strokeColor="@color/black"
    app:strokeWidth="2dp"
    app:cardCornerRadius="10dp"
    >
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">
        <TextView
            android:id="@+id/heading"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Recommonded Courses"
            android:textSize="28sp"
            android:fontFamily="@font/monda"
            android:textColor="@color/black"
            android:layout_gravity="center"
            android:gravity="center"
            android:textAlignment="center"
            android:layout_marginTop="10dp"/>

        <ImageView
            android:id="@+id/imgshown"
            android:layout_width="190dp"
            android:layout_height="190dp"
            android:layout_gravity="center"
            android:src="@drawable/finallogo"/>

        <TextView
            android:id="@+id/courseContent"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text=" Business Analysis Fundamentals (Udemy, Coursera) \nProject Management Professional (PMP) Certification, \nHealthcare Management Courses,
        \nData Visualization Courses (Tableau, Power BI)"

            />


    </LinearLayout>


</com.google.android.material.card.MaterialCardView>