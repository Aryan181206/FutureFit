<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"

    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/white"
    tools:context=".Assessment.PersonalityTraitQuiz">

    <androidx.cardview.widget.CardView
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <ImageView
            android:layout_width="200dp"
            android:layout_height="60dp"
            android:layout_marginBottom="5dp"
            android:layout_marginTop="5dp"
            android:layout_gravity="center"
            android:src="@drawable/finallogo2" />
    </androidx.cardview.widget.CardView>


    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="16dp"
        android:orientation="vertical">

    <!-- Title -->
    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Personality Trait Test\n(MBTI Profiling)"
        android:textAppearance="@style/TextAppearance.Material3.TitleLarge"
        android:textStyle="bold"
        android:layout_marginTop="10dp"
        android:textColor="@color/textcolor"
        android:gravity="center"
        android:layout_marginBottom="16dp"
        android:fontFamily="@font/ar_one_sans" />

    <!-- Current Dimension Title -->
    <TextView
        android:id="@+id/dimensionTitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Dimension"
        android:layout_gravity="center"
        android:textSize="24sp"
        android:textStyle="bold"
        android:textColor="@color/black"
        android:layout_marginBottom="8dp" />

    <!-- Progress Bar -->
    <com.google.android.material.progressindicator.LinearProgressIndicator
        android:id="@+id/progressBar2"
        android:layout_width="match_parent"
        android:layout_height="8dp"
        android:layout_marginVertical="16dp"
        android:progress="20"
        app:trackThickness="8dp"
        android:padding="16dp"
        app:indicatorColor="@color/primaryColor"
        app:trackColor="@color/lightgray" />

    <!-- Question Text -->
    <TextView
        android:id="@+id/questionText"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Question goes here"
        android:textAppearance="@style/TextAppearance.Material3.TitleMedium"
        android:fontFamily="@font/ar_one_sans"
        android:textStyle="bold"
        android:padding="16dp"
        android:layout_marginBottom="12dp"
        android:textColor="@color/textcolor" />

    <!-- Option Buttons -->
    <RadioGroup
        android:id="@+id/optionsGroup"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <!-- Sample option style -->
        <RadioButton
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:padding="16dp"
            android:text="Option 1"
            android:textSize="16sp"
            android:buttonTint="@color/primaryColor"
            android:textColor="@color/black"
            android:background="@drawable/radio_selector_bg"
            android:layout_marginBottom="8dp" />

        <!-- Add more RadioButtons dynamically -->
    </RadioGroup>

    <!-- Next Button -->
    <com.google.android.material.button.MaterialButton
        android:id="@+id/nextButton"
        style="@style/Widget.Material3.Button"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Next"
        android:layout_marginTop="24dp"
        android:textAllCaps="false"
        android:fontFamily="@font/ar_one_sans"
        app:cornerRadius="12dp"
        app:backgroundTint="@color/primaryColor"
        android:textColor="@color/white" />
    </LinearLayout>

</LinearLayout>
