<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
   
    android:background="#FFFFFF">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="20dp"
        android:orientation="vertical">
        
        <ImageView
            android:layout_width="match_parent"
            android:layout_height="90dp"
            android:layout_marginTop="10dp"
            android:src="@drawable/finallogo"/>

        <!-- Title -->
        <TextView
            android:id="@+id/titleAboutUs"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="About FutureFit"
            android:textSize="24sp"
            android:textStyle="bold"
            android:textColor="#000000"
            android:layout_gravity="start"
            android:paddingBottom="16dp" />

        <!-- Intro -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="FutureFit helps you explore your strengths, understand yourself better, and discover careers that truly suit you. Here's everything you can do with the app:"
            android:textSize="16sp"
            android:textColor="#444444"
            android:paddingBottom="16dp" />

        <!-- Sections -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="🌟 1. Build Your Profile\nTell us about yourself by filling in your personal and educational information."
            android:textSize="16sp"
            android:paddingBottom="12dp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="🧠 2. Test Your Aptitude\nTake fun questions to check your logical, numerical, and verbal abilities. See your scores instantly."
            android:textSize="16sp"
            android:paddingBottom="12dp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="🧬 3. Discover Your Personality\nAnswer simple questions and get your personality type (like INTJ, ENFP, etc.)."
            android:textSize="16sp"
            android:paddingBottom="12dp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="🎯 4. Share Your Interests\nChoose what you love doing. Your interests help us match you with careers you'll enjoy."
            android:textSize="16sp"
            android:paddingBottom="12dp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="💼 5. Add Your Skills  \nList your technical and soft skills."
            android:textSize="16sp"
            android:paddingBottom="12dp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="📊 6. Add Job Experience (If Any)\nInclude details about your past jobs or internships to improve suggestions."
            android:textSize="16sp"
            android:paddingBottom="12dp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="🔍 7. Get AI-Powered Career Suggestions\nBased on your data, we suggest careers that match your profile best."
            android:textSize="16sp"
            android:paddingBottom="12dp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="❤️ 8. Save Your Favorite Careers\nLike a career? Save it and check it anytime later from your saved list."
            android:textSize="16sp"
            android:paddingBottom="12dp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="📚 9. View All Your Past Predictions\nSee all the career suggestions you've received earlier to compare easily."
            android:textSize="16sp"
            android:paddingBottom="12dp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="👤 10. Your Personal Dashboard\nView and manage all your details and assessments in one place."
            android:textSize="16sp"
            android:paddingBottom="16dp" />

        <!-- Ending note -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="✨ FutureFit is your step-by-step guide to a career that fits YOU perfectly."
            android:textStyle="italic"
            android:textSize="16sp"
            android:textColor="#333333"
            android:paddingBottom="24dp" />
    </LinearLayout>
</ScrollView>
