<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".AssessmentResult.AptitudeResult">


    <androidx.cardview.widget.CardView
        android:layout_width="match_parent"
        android:layout_height="60dp"
        >

        <ImageView
            android:layout_width="160dp"
            android:layout_height="60dp"
            android:src="@drawable/finallogo2"
            android:layout_marginLeft="20dp"/>
    </androidx.cardview.widget.CardView>

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Completed"
        android:textColor="@color/black"
        android:fontFamily="@font/monda"
        android:textSize="30dp"
        android:layout_gravity="center_horizontal"
        android:layout_marginTop="8dp"
        />

    <ImageView
        android:layout_width="210dp"
        android:layout_height="210dp"
        android:src="@drawable/done"
        android:layout_gravity="center_horizontal"/>
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center_horizontal"
        android:gravity="center_horizontal"
        android:text="You have successfully completed the Aptitude Assessment."
        android:textColor="@color/black"
        android:textSize="18dp"
        android:layout_marginTop="8dp"
        android:fontFamily="@font/monda"
        android:layout_marginHorizontal="10dp"
        />



    <androidx.cardview.widget.CardView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/white"
        app:cardCornerRadius="10dp"
        android:layout_marginHorizontal="12dp"
        android:layout_marginTop="12dp"
        android:backgroundTint="#FFFFFF"
        >

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_marginHorizontal="5dp"
            android:orientation="vertical">
        <!-- Title -->
        <TextView
            android:id="@+id/titleText"
            android:layout_marginTop="12dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Aptitude Test Results"
            android:textSize="24sp"
            android:textStyle="bold"
            android:gravity="center"
            android:paddingBottom="16dp" />

        <!-- Numerical Test Result -->
        <TextView
            android:id="@+id/numericalLabel"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Numerical Reasoning:"
            android:textSize="18sp"
            android:layout_marginHorizontal="15dp"
            android:textStyle="bold"
            android:paddingTop="8dp" />


            <ProgressBar
                android:id="@+id/numprogress"
                style="?android:attr/progressBarStyleHorizontal"
                android:layout_width="match_parent"
                android:layout_marginTop="10dp"
                android:layout_marginHorizontal="15dp"
                android:layout_height="wrap_content" />

            <TextView
            android:id="@+id/numericalScore"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Loading..."
                android:gravity="center_horizontal"
            android:layout_marginHorizontal="15dp"
            android:textSize="16sp"
            android:paddingBottom="12dp" />

        <!-- Logical Test Result -->
            <!-- Numerical Test Result -->
            <TextView

                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Logical Reasoning:"
                android:textSize="18sp"
                android:layout_marginHorizontal="15dp"
                android:textStyle="bold"
                android:paddingTop="8dp" />


            <ProgressBar
                android:id="@+id/logprogress"
                style="?android:attr/progressBarStyleHorizontal"
                android:layout_width="match_parent"
                android:layout_marginTop="10dp"
                android:layout_marginHorizontal="15dp"
                android:layout_height="wrap_content" />

            <TextView
                android:id="@+id/logicalScore"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Loading..."
                android:gravity="center_horizontal"
                android:layout_marginHorizontal="15dp"
                android:textSize="16sp"
                android:paddingBottom="12dp"
                 />

            <TextView

                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Verbal Ability:"
                android:textSize="18sp"
                android:layout_marginHorizontal="15dp"
                android:textStyle="bold"
                android:paddingTop="8dp" />


            <ProgressBar
                android:id="@+id/vebprogress"
                style="?android:attr/progressBarStyleHorizontal"
                android:layout_width="match_parent"
                android:layout_marginTop="10dp"
                android:layout_marginHorizontal="15dp"
                android:layout_height="wrap_content" />

            <TextView
                android:id="@+id/verbalScore"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Loading..."
                android:gravity="center_horizontal"
                android:layout_marginHorizontal="15dp"
                android:textSize="16sp"
                android:paddingBottom="12dp"/>

        </LinearLayout>

    </androidx.cardview.widget.CardView>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent">
        <androidx.cardview.widget.CardView
            android:id="@+id/backhome"
            android:layout_width="match_parent"
            android:layout_height="40dp"
            android:layout_gravity="bottom"
            android:layout_marginBottom="10dp"
            android:layout_marginHorizontal="15dp"
            app:cardBackgroundColor="@color/Sky"
            android:elevation="15dp"
            app:cardCornerRadius="12dp">
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Go To Home"
                android:textColor="@color/white"
                android:textStyle="bold"
                android:textSize="25dp"
                android:layout_gravity="center"
                android:fontFamily="@font/monda"/>
        </androidx.cardview.widget.CardView>

    </LinearLayout>
    </LinearLayout>


