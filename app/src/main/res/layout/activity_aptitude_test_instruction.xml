<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".AssessmentInstructions.AptitudeTestInstruction">

    <androidx.cardview.widget.CardView
        android:layout_width="match_parent"
        android:layout_height="65dp"
        >
        <ImageView
            android:layout_width="200dp"
            android:layout_height="60dp"
            android:layout_marginStart="10dp"
            android:src="@drawable/finallogo2"/>
    </androidx.cardview.widget.CardView>

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Aptitude Assesment"
        android:textColor="@color/black"
        android:fontFamily="@font/baloo_thambi"
        android:textSize="29dp"
        android:layout_gravity="center_horizontal"
        android:layout_marginTop="20dp"/>

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Instructions"
        android:textSize="20sp"
        android:textColor="@color/textcolor"
        android:textStyle="bold"
        android:layout_marginTop="10dp"
        android:layout_marginStart="15dp"/>

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="20sp"
        android:text="1. This is Aptitude Assessment test by which your logical, verbal and Numerical Skills will be tested ."
        android:textSize="15dp"
        android:textColor="@color/black"
        android:layout_marginHorizontal="15dp"
        android:fontFamily="@font/monda"
        />


    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="2. The Test include three Sections: \n         1.Logical Reasoning\n         2.Verbal Reasoning\n         3.Numerical Reasoning     "
        android:textSize="15dp"
        android:layout_marginTop="5dp"
        android:textColor="@color/black"
        android:layout_marginHorizontal="15dp"
        android:fontFamily="@font/monda"/>

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="3. Time Alloted for Each Section is 5 minutes. "
        android:textSize="15dp"
        android:layout_marginTop="5dp"
        android:textColor="@color/black"
        android:layout_marginHorizontal="15dp"
        android:fontFamily="@font/monda"/>

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="5dp"
        android:text="4. You Must Attempt the all three section one by one."
        android:textSize="15dp"
        android:textColor="@color/black"
        android:layout_marginHorizontal="15dp"
        android:fontFamily="@font/monda"/>

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:textSize="15dp"
        android:textColor="@color/black"
        android:layout_marginTop="5dp"
        android:layout_marginHorizontal="15dp"
        android:fontFamily="@font/monda"
        android:text="5. Final Score of Each Section will be shown seperately."/>

    <androidx.cardview.widget.CardView
        android:id="@+id/startAptitudeTest"
        android:layout_width="match_parent"
        android:layout_height="50dp"
        android:layout_marginHorizontal="18dp"
        android:backgroundTint="@color/Sky"
        android:elevation="5dp"
        android:layout_marginTop="25dp"
        app:cardMaxElevation="100dp"
        app:cardElevation="10dp"
        app:cardCornerRadius="10dp"
        >
        <TextView
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:text="Start"
            android:fontFamily="@font/baloo_thambi"
            android:textSize="25dp"
            android:layout_gravity="center"
            android:gravity="center"
            android:textColor="@color/Royalwhite"/>
    </androidx.cardview.widget.CardView>






</LinearLayout>