<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:id="@+id/homeFrag"
    android:backgroundTint="@color/Royalwhite"
    android:layout_height="match_parent"
    tools:context=".Fragments.HomeFrag">
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

    <androidx.cardview.widget.CardView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"

        >
        <ImageView
            android:id="@+id/imageView1"
            android:layout_width="165dp"
            android:layout_marginStart="15dp"
            android:layout_marginTop="10dp"
            android:layout_marginBottom="5dp"
            android:layout_height="68dp"
            android:src="@drawable/finallogo2" />
    </androidx.cardview.widget.CardView>

        <ScrollView
            android:layout_width="match_parent"
            android:layout_height="match_parent">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical" >

                <androidx.cardview.widget.CardView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_margin="16dp"
                    android:elevation="7dp"
                    app:cardCornerRadius="10dp">
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="center_horizontal"
                        android:fontFamily="@font/ar_one_sans"
                        android:paddingTop="18dp"
                        android:text="Discover Your Perfect Career Path"
                        android:textColor="#353333"
                        android:textSize="22dp"
                        android:textStyle="bold"/>
                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Take our comprehensive assessment to \ntest you potential"
                        android:paddingStart="25dp"
                        android:textSize="16dp"
                        android:fontFamily="@font/ar_one_sans"
                        android:layout_marginTop="53dp"/>
                    <androidx.cardview.widget.CardView
                        android:id="@+id/startassessment"
                        android:layout_width="match_parent"
                        android:layout_height="50dp"
                        android:layout_marginTop="120dp"
                        android:layout_marginHorizontal="16dp"
                        android:layout_marginBottom="11dp"
                        android:backgroundTint="@color/Sky"
                        app:cardCornerRadius="10dp">
                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:text="Start Assessment"
                            android:textColor="@color/white"
                            android:textSize="22dp"
                            android:textStyle="bold"
                            android:fontFamily="@font/ar_one_sans"
                            android:gravity="center"/>
                    </androidx.cardview.widget.CardView>
                </androidx.cardview.widget.CardView>

                <androidx.cardview.widget.CardView
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:layout_marginTop="5dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical">
                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:fontFamily="@font/ar_one_sans"
                            android:paddingStart="25dp"
                            android:paddingTop="16dp"
                            android:text="Assessment Categories"
                            android:textColor="#353333"
                            android:textSize="25dp"
                            android:textStyle="bold" />


                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_gravity="center_horizontal"
                            android:gravity="center"
                            android:orientation="horizontal">
                            <androidx.cardview.widget.CardView
                                android:id="@+id/AssessmentAptitudeTest"
                                android:layout_width="170dp"
                                android:layout_height="100dp"
                                android:layout_marginEnd="25dp"
                                app:cardCornerRadius="10dp"
                                android:layout_marginVertical="15dp"
                                android:layout_gravity="center">

                                <LinearLayout
                                    android:layout_width="match_parent"
                                    android:layout_height="match_parent"
                                    android:orientation="vertical"
                                    android:background="#F3F1FD">
                                    <ImageView
                                        android:layout_width="35dp"
                                        android:layout_height="35dp"
                                        android:src="@drawable/brain"
                                        android:layout_marginLeft="10dp"
                                        android:layout_marginTop="10dp"/>
                                    <TextView
                                        android:layout_width="wrap_content"
                                        android:layout_height="wrap_content"
                                        android:layout_marginLeft="10dp"
                                        android:textSize="15dp"
                                        android:textStyle="bold"
                                        android:textColor="@color/textcolor"
                                        android:layout_marginTop="1dp"
                                        android:text="Aptitude Test"/>
                                    <TextView
                                        android:layout_width="wrap_content"
                                        android:layout_height="wrap_content"
                                        android:text="Measure your abilities"
                                        android:textSize="12dp"
                                        android:layout_marginTop="2dp"
                                        android:layout_marginLeft="10dp"/>
                                </LinearLayout>


                            </androidx.cardview.widget.CardView>
                            <androidx.cardview.widget.CardView
                                android:id="@+id/AssessmentPersonalityTest"
                                android:layout_width="170dp"
                                android:layout_height="100dp"
                                app:cardCornerRadius="10dp"
                                android:layout_marginVertical="15dp"
                                android:layout_gravity="center">
                                <LinearLayout
                                    android:layout_width="match_parent"
                                    android:layout_height="match_parent"
                                    android:orientation="vertical"
                                    android:background="#EAFBF3">
                                    <ImageView
                                        android:layout_width="35dp"
                                        android:layout_height="35dp"
                                        android:src="@drawable/persontick"
                                        android:layout_marginLeft="10dp"
                                        android:layout_marginTop="10dp"/>
                                    <TextView
                                        android:layout_width="wrap_content"
                                        android:layout_height="wrap_content"
                                        android:layout_marginLeft="10dp"
                                        android:textSize="15dp"
                                        android:textStyle="bold"
                                        android:textColor="@color/textcolor"
                                        android:layout_marginTop="1dp"
                                        android:text="Personality"/>
                                    <TextView
                                        android:layout_width="wrap_content"
                                        android:layout_height="wrap_content"
                                        android:text="Know your traits"
                                        android:textSize="12dp"
                                        android:layout_marginTop="2dp"
                                        android:layout_marginLeft="10dp"/>
                                </LinearLayout>
                            </androidx.cardview.widget.CardView>
                        </LinearLayout>

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_gravity="center_horizontal"
                            android:gravity="center"
                            android:orientation="horizontal">
                            <androidx.cardview.widget.CardView
                                android:id="@+id/AssessmentInterestTest"
                                android:layout_width="170dp"
                                android:layout_height="100dp"
                                android:layout_marginEnd="25dp"
                                app:cardCornerRadius="10dp"
                                android:layout_marginVertical="3dp"
                                android:layout_gravity="center">
                                <LinearLayout
                                    android:layout_width="match_parent"
                                    android:layout_height="match_parent"
                                    android:orientation="vertical"
                                    android:background="#FDF5EB">
                                    <ImageView
                                        android:layout_width="35dp"
                                        android:layout_height="35dp"
                                        android:src="@drawable/star"
                                        android:layout_marginLeft="10dp"
                                        android:layout_marginTop="10dp"/>

                                    <TextView
                                        android:layout_width="wrap_content"
                                        android:layout_height="wrap_content"
                                        android:layout_marginLeft="10dp"
                                        android:layout_marginTop="1dp"
                                        android:text="Interests"
                                        android:textColor="@color/textcolor"
                                        android:textSize="15dp"
                                        android:textStyle="bold" />

                                    <TextView
                                        android:layout_width="wrap_content"
                                        android:layout_height="wrap_content"
                                        android:text="Explore passions"
                                        android:textSize="12dp"
                                        android:layout_marginTop="2dp"
                                        android:layout_marginLeft="10dp"/>
                                </LinearLayout>

                            </androidx.cardview.widget.CardView>

                            <androidx.cardview.widget.CardView
                                android:id="@+id/ProvideSkills"
                                android:layout_width="170dp"
                                android:layout_height="100dp"
                                app:cardCornerRadius="10dp"
                                android:layout_gravity="center">
                                <LinearLayout
                                    android:layout_width="match_parent"
                                    android:layout_height="match_parent"
                                    android:orientation="vertical"
                                    android:background="#EDF4FD">
                                    <ImageView
                                        android:layout_width="35dp"
                                        android:layout_height="35dp"
                                        android:src="@drawable/skills"
                                        android:layout_marginLeft="10dp"
                                        android:layout_marginTop="10dp"/>

                                    <TextView
                                        android:layout_width="wrap_content"
                                        android:layout_height="wrap_content"
                                        android:layout_marginLeft="10dp"
                                        android:layout_marginTop="1dp"
                                        android:text="Skills"
                                        android:textColor="@color/textcolor"
                                        android:textSize="15dp"
                                        android:textStyle="bold" />

                                    <TextView
                                        android:layout_width="wrap_content"
                                        android:layout_height="wrap_content"
                                        android:text="Add your expertise"
                                        android:textSize="12dp"
                                        android:layout_marginTop="2dp"
                                        android:layout_marginLeft="10dp"/>
                                </LinearLayout>
                            </androidx.cardview.widget.CardView>
                        </LinearLayout>


                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:fontFamily="@font/ar_one_sans"
                            android:paddingStart="25dp"
                            android:paddingTop="16dp"
                            android:layout_marginTop="5dp"
                            android:text="Recommondations"
                            android:textColor="#353333"
                            android:textSize="20dp"
                            android:textStyle="bold" />

                        <androidx.cardview.widget.CardView
                            android:id="@+id/ProvideExperience"
                            android:layout_width="match_parent"
                            android:layout_height="68dp"
                            android:layout_marginTop="10dp"
                            android:layout_marginHorizontal="22dp"
                            app:cardCornerRadius="10dp"
                            android:layout_marginBottom="3dp"
                            >
                            <ImageView
                                android:layout_width="45dp"
                                android:layout_height="45dp"
                                android:src="@drawable/experience"
                                android:layout_gravity="center_vertical"
                                android:layout_marginLeft="10dp"/>
                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginLeft="70dp"
                                android:layout_marginTop="10dp"
                                android:text="Experience"
                                android:textColor="@color/textcolor"
                                android:textSize="18dp"
                                android:textStyle="bold"
                                />
                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Add you work experience for right AI Guidance"
                                android:textSize="13dp"
                                android:layout_marginTop="35dp"
                                android:layout_marginLeft="70dp"/>
                        </androidx.cardview.widget.CardView>

                        <androidx.cardview.widget.CardView
                            android:id="@+id/ProvideCertificates"
                            android:layout_width="match_parent"
                            android:layout_height="68dp"
                            android:layout_marginHorizontal="22dp"
                            app:cardCornerRadius="10dp"
                            android:layout_marginTop="5dp"
                            android:layout_marginBottom="3dp"
                            >
                            <ImageView
                                android:layout_width="45dp"
                                android:layout_height="45dp"
                                android:src="@drawable/certificate"
                                android:layout_gravity="center_vertical"
                                android:layout_marginLeft="10dp"/>
                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginLeft="70dp"
                                android:layout_marginTop="10dp"
                                android:text="Certification"
                                android:textColor="@color/textcolor"
                                android:textSize="18dp"
                                android:textStyle="bold"
                                />
                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Provide your Certificates for prediciting right career opportunities"
                                android:textSize="13dp"
                                android:layout_marginTop="35dp"
                                android:layout_marginLeft="70dp"/>
                        </androidx.cardview.widget.CardView>

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:layout_marginTop="25dp"
                            android:layout_marginBottom="15dp"
                            android:orientation="horizontal">
                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Career Prediction :"
                                android:textSize="20dp"
                                android:textColor="@color/textcolor"
                                android:textStyle="bold"
                                android:fontFamily="@font/ar_one_sans"
                                android:layout_gravity="center_vertical"
                                android:layout_marginLeft="18dp"/>
                            <androidx.cardview.widget.CardView
                                android:id="@+id/profilestatus"
                                android:layout_width="match_parent"
                                android:layout_height="60dp"
                                app:cardCornerRadius="7dp"
                                android:layout_gravity="center_vertical"
                                android:layout_marginStart="12dp"
                                android:backgroundTint="@color/Sky"
                                android:layout_marginEnd="22dp">

                                <TextView
                                    android:layout_width="match_parent"
                                    android:layout_height="match_parent"
                                    android:layout_gravity="center"
                                    android:fontFamily="@font/ar_one_sans"
                                    android:gravity="center"
                                    android:text="Check Profile Status"
                                    android:textColor="@color/white"
                                    android:textSize="20dp"/>
                            </androidx.cardview.widget.CardView>
                        </LinearLayout>
                    </LinearLayout>
                </androidx.cardview.widget.CardView>

            </LinearLayout>
        </ScrollView>


    </LinearLayout>
</FrameLayout>