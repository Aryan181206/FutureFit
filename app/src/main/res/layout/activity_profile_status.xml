<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:orientation="vertical"
    android:backgroundTint="@color/Royalwhite"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".ProfileStatus">

    <androidx.cardview.widget.CardView
        android:layout_width="match_parent"
        android:layout_height="75dp"
        android:elevation="15dp">
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Profile Status"
            android:textSize="28dp"
            android:textColor="@color/textcolor"
            android:textStyle="bold"
            android:fontFamily="@font/ar_one_sans"
            android:layout_marginTop="11dp"
            android:layout_marginStart="16dp"/>
    </androidx.cardview.widget.CardView>

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Profile Completion"
        android:textStyle="bold"
        android:layout_marginTop="15dp"
        android:textSize="31dp"
        android:textColor="@color/black"
        android:fontFamily="@font/ar_one_sans"
        android:layout_marginStart="16dp"/>

    <ProgressBar
        android:id="@+id/progressBar"
        style="?android:attr/progressBarStyleHorizontal"
        android:layout_width="match_parent"
        android:layout_height="20dp"
        android:layout_marginTop="5dp"
        android:layout_marginHorizontal="16dp"/>

    <androidx.cardview.widget.CardView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="16dp"
        app:cardCornerRadius="10dp"
        android:layout_marginTop="15dp">
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical">
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Personal Information"
                android:textColor="@color/textcolor"
                android:textSize="20dp"
                android:textStyle="bold"
                android:layout_marginTop="10dp"
                android:layout_marginStart="16dp"/>
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginTop="7dp">
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Full Name"
                    android:textSize="18dp"
                    android:textColor="@color/black"
                    android:paddingStart="16dp"
                    android:layout_gravity="center_vertical"/>
                <ImageView
                    android:id="@+id/dcbName"
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:layout_marginLeft="245dp"
                    android:layout_gravity="center_vertical"
                    android:src="@drawable/baseline_check_box_24"/>
            </LinearLayout>
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginTop="7dp">
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Age"
                    android:textSize="18dp"
                    android:paddingStart="16dp"
                    android:textColor="@color/black"
                    android:layout_gravity="center_vertical"/>
                <ImageView
                    android:id="@+id/dcbAge"
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:layout_marginLeft="295dp"
                    android:layout_gravity="center_vertical"
                    android:src="@drawable/baseline_check_box_24"/>
            </LinearLayout>
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginBottom="12dp"
                android:layout_marginTop="7dp">
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Location"
                    android:textSize="18dp"
                    android:paddingStart="16dp"
                    android:textColor="@color/black"
                    android:layout_gravity="center_vertical"/>
                <ImageView
                    android:id="@+id/dcbLocation"
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:layout_marginLeft="257dp"
                    android:layout_gravity="center_vertical"
                    android:src="@drawable/baseline_check_box_24"/>
            </LinearLayout>
        </LinearLayout>
    </androidx.cardview.widget.CardView>



    <androidx.cardview.widget.CardView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="16dp"
        app:cardCornerRadius="10dp"
        android:layout_marginTop="15dp">
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical">
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Personal Information"
                android:textColor="@color/textcolor"
                android:textSize="20dp"
                android:textStyle="bold"
                android:layout_marginTop="10dp"
                android:layout_marginStart="16dp"/>
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginTop="7dp">
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Full Name"
                    android:textSize="18dp"
                    android:textColor="@color/black"
                    android:paddingStart="16dp"
                    android:layout_gravity="center_vertical"/>
                <ImageView
                    android:id="@+id/dcbName"
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:layout_marginLeft="245dp"
                    android:layout_gravity="center_vertical"
                    android:src="@drawable/baseline_check_box_24"/>
            </LinearLayout>
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginTop="7dp">
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Age"
                    android:textSize="18dp"
                    android:paddingStart="16dp"
                    android:textColor="@color/black"
                    android:layout_gravity="center_vertical"/>
                <ImageView
                    android:id="@+id/dcbAge"
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:layout_marginLeft="295dp"
                    android:layout_gravity="center_vertical"
                    android:src="@drawable/baseline_check_box_24"/>
            </LinearLayout>
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginBottom="12dp"
                android:layout_marginTop="7dp">
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Location"
                    android:textSize="18dp"
                    android:paddingStart="16dp"
                    android:textColor="@color/black"
                    android:layout_gravity="center_vertical"/>
                <ImageView
                    android:id="@+id/dcbLocation"
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:layout_marginLeft="257dp"
                    android:layout_gravity="center_vertical"
                    android:src="@drawable/baseline_check_box_24"/>
            </LinearLayout>
        </LinearLayout>
    </androidx.cardview.widget.CardView>










</LinearLayout>