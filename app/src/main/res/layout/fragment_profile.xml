                        <ProgressBar
                            android:id="@+id/AptitdeNumericalProgress"
                            android:layout_width="116dp"
                            android:layout_height="110dp"
                            android:layout_gravity="center_horizontal"/>
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="4dp"
                            android:fontFamily="@font/monda"
                            android:layout_gravity="center_horizontal"
                            android:text="Aptitude Numerical Reasoning Score"
                            android:textColor="@color/textcolor"
                            android:textSize="16dp"/>
                        <TextView
                            android:id="@+id/AptitdeNumericalScore"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:fontFamily="@font/monda"
                            android:text="89.00%"
                            android:textStyle="bold"
                            android:textColor="@color/textcolor"
                            android:textSize="19dp"
                            android:layout_gravity="center_horizontal"/>

                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="190dp"
                        android:layout_marginTop="25dp"
                        android:orientation="vertical"
                        app:layout_constraintTop_toBottomOf="@+id/AptitdeLogicalScore">

                        <ProgressBar
                            android:id="@+id/AptitdeVerbalProgress"
