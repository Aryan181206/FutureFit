<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:layout_margin="12dp"
    tools:context=".AddSEC.AddExperience">

    <!-- Logo Card -->
    <androidx.cardview.widget.CardView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="8dp">

        <ImageView
            android:layout_width="200dp"
            android:layout_height="60dp"
            android:src="@drawable/finallogo2"
            android:contentDescription="Logo" />
    </androidx.cardview.widget.CardView>

    <!-- Title and Add Button Row -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_marginBottom="8dp">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Experience"
            android:textSize="26sp"
            android:textColor="@color/black"
            android:fontFamily="@font/monda" />

        <androidx.cardview.widget.CardView
            android:id="@+id/addPositionCard"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:cardCornerRadius="10dp"
            app:cardBackgroundColor="@color/Sky"
            android:layout_marginStart="8dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:paddingVertical="8dp"
                android:paddingHorizontal="12dp"
                android:text="Add Position"
                android:textColor="@color/white"
                android:textSize="16sp"
                android:drawableStart="@drawable/baseline_add_24"
                android:drawablePadding="6dp"
                android:fontFamily="@font/monda" />
        </androidx.cardview.widget.CardView>
    </LinearLayout>

    <!-- No Experience Checkbox -->
    <CheckBox
        android:id="@+id/pastexpno"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="No Past Experience"
        android:textSize="16sp"
        android:layout_marginBottom="8dp" />

    <!-- Scrollable container for positions -->
    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true">

        <LinearLayout
            android:id="@+id/positionContainer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:layout_marginVertical="8dp" />
    </ScrollView>

    <!-- Save Button -->
    <androidx.cardview.widget.CardView
        android:id="@+id/saveChanges"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:layout_marginBottom="8dp"
        app:cardCornerRadius="12dp"
        app:cardBackgroundColor="@color/Sky">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:text="Save Changes"
            android:textColor="@color/white"
            android:textSize="20sp"

            android:padding="12dp"
            android:fontFamily="@font/monda" />
    </androidx.cardview.widget.CardView>

</LinearLayout>
